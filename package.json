    "test:e2e:perf": "playwright test e2e/admin-perf.spec.js",
    "test:e2e:responsive": "playwright test e2e/admin-responsive.spec.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "verify:navbar": "node scripts/verify-navbar-geometry.mjs",
    "verify:browser": "node scripts/verify-browser-harness.mjs",
    "runtime:tick": "node scripts/runtime-tick.mjs",
    "agents:live-smoke": "node scripts/agents-live-smoke.mjs",
    "workforce:bootstrap": "node scripts/workforce-bootstrap.mjs",
    "workforce:verify": "node scripts/workforce-verify.mjs",
    "workforce:test-double": "vitest run lib/core/workforce-i2/phase-i2.test.js -t \"software-house test-double\"",
