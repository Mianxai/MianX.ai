    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^29.1.1",
    "playwright": "^1.55.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
